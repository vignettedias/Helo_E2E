# TLS termination for the Helo relay and web client.
#
# Caddy obtains and renews certificates automatically. Note carefully: TLS here
# protects metadata in transit and authenticates the SERVER to the client. It
# provides NO message confidentiality guarantee -- that comes entirely from the
# Double Ratchet, which is why a compromised or malicious TLS terminator still
# cannot read messages.

{$RELAY_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Content-Security-Policy and Permissions-Policy come from each backend:
	# the relay sends default-src 'none' on every API response, and the web
	# container sends the policy the app needs (docker/Caddyfile.web). Setting
	# one here would override the other.

	# The relay API, on the same origin as the app. These are the relay's
	# top-level routes (the same list as RELAY_PREFIXES in scripts/run_demo.py).
	@relay path /auth /auth/* /devices /devices/* /prekeys /prekeys/* /users /users/* /presence /presence/* /messages /messages/* /delivery /delivery/* /attachments /attachments/* /me /me/* /reports /reports/* /health

	# Server-Sent Events delivery stream must not be buffered or timed out.
	@stream path /messages/stream
	reverse_proxy @stream relay:8443 {
		flush_interval -1
		transport http {
			response_header_timeout 24h
		}
	}

	reverse_proxy @relay relay:8443

	# Everything else is the web client.
	reverse_proxy web:8080

	log {
		output stdout
		format json
		# Access logs are metadata. Retain them briefly and never log request
		# bodies -- a body log would write user ciphertext into the log store,
		# where access control is typically weaker than the database's.
	}
}
