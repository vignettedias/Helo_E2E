# Relay configuration (backend/src/server.js). Copy to .env or export these.
# Nothing here is secret: the relay holds no server-side key material.

# Listen port and bind address. Bind to 127.0.0.1 unless a TLS-terminating
# proxy on another host forwards to this process; the relay speaks plain HTTP.
PORT=8443
HOST=127.0.0.1

# SQLite database file (created and migrated on start).
DB_PATH=./data/helo.db

# Exact browser origins allowed to call the relay (comma separated). Leave
# empty for native clients only: CORS is then off entirely.
# scripts/run_demo.py sets this itself for http://localhost:5000,5001.
CORS_ORIGINS=

# Behind a reverse proxy on THIS machine (e.g. run_demo.py --lan): let the
# proxy name the real client for rate limiting. Only loopback is trusted.
TRUST_PROXY_LOOPBACK=0

# Upper bound for one encrypted attachment, in bytes (default 25 MiB).
MAX_ATTACHMENT_BYTES=26214400

# Client-side tooling (scripts/verify.py) — optional paths when not on PATH.
# HELO_FLUTTER=C:/flutter/bin/flutter.bat
# HELO_RUFF=/path/to/ruff
